# mock = $0 (fully simulated) | hybrid = real LLM + images, mock video | live = all OpenRouter
MEDIA_EXECUTION_MODE=mock

MAX_CAMPAIGN_BUDGET_USD=1.50
MAX_VISION_QA_RETRIES=1

# Only used in hybrid or live mode
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Model routing (OpenRouter model IDs).
# These are the initial defaults; the studio lets you change the four campaign
# models from the frontend per campaign. The brief model is server-side and
# optimized for fast one-click drafts. Image and video IDs must also exist in
# src/infrastructure/openrouter/models-snapshot.json. TEXT and VISION_QA
# models must accept image input; BRIEF may be text-only.
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_VISION_QA_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_BRIEF_MODEL=meta/muse-ember
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
OPENROUTER_VIDEO_MODEL=heygen/heygen-video-1

# Required for live video: frame_images must be public HTTPS URLs (Vercel Blob).
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
